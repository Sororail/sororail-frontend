# Environment for apps/web. Copy to apps/web/.env.local and uncomment what you
# need. Every variable is optional: the defaults below target the public
# Stellar testnet. Next.js inlines NEXT_PUBLIC_* values at build time, so
# restart the dev server (or rebuild) after changing them.

# Soroban RPC endpoint. It must serve testnet: the app reads the RPC's network
# passphrase at startup and refuses to run against any other network.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Token the payroll screen pays out in. Defaults to native XLM's Stellar Asset
# Contract on testnet.
# NEXT_PUBLIC_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# The shared batch_payout deployment used by the payroll and overview screens.
# Override it after a testnet reset, or to use your own deployment.
# NEXT_PUBLIC_BATCH_PAYOUT_ID=CDKJ56S7K7QC4LG6SFF2OGDTG6N4QBCJOVRWHY7MKCWD5JPQ6MDAHRAM

# Block explorer base for transaction and contract links. When unset it is
# derived from the RPC URL: a testnet RPC host links to the testnet explorer,
# and any other RPC gets no explorer links.
# NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
