# Copy this file to .dev.vars and fill in real values for local Wrangler dev.
# .dev.vars is listed in .gitignore — never commit it with real secrets.

# Raw hex-encoded Ed25519 seed for the keeper Stellar account.
# Must match the variable name the worker reads: env.KEEPER_PRIVATE_KEY_HEX
KEEPER_PRIVATE_KEY_HEX=<your-64-char-hex-ed25519-seed>

# Stellar public key (G...) of the keeper account derived from the seed above.
KEEPER_ACCOUNT_ID=<your-stellar-account-id>

# Secret token for the admin API endpoints.
ADMIN_API_TOKEN=<your-admin-api-token>

# JSON array of price feed configurations (see README for schema).
PRICE_FEED_CONFIG=[]
